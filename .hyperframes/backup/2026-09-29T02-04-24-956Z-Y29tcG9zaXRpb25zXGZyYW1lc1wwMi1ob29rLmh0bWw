          gsap.set(copyChars, { y: px(4.6) });
          gsap.set(yeonSy, { autoAlpha: 0, y: 0, scale: 1, transformOrigin: "50% 60%" });
          gsap.set(cam3, { scale: 1, transformOrigin: "50% 50%" });

          var tl = gsap.timeline({ paused: true, defaults: { immediateRender: false } });

          function ft(el, from, to, t) {
            to.immediateRender = false;
            tl.fromTo(el, from, to, t);
          }
          function set(el, v, t) {
            tl.set(el, v, t);
          }
          // screen-shake: 0ms steps, then home
          function shake(el, t, amps) {
            for (var i = 0; i < amps.length; i++) {
              set(el, { x: px(amps[i]), y: px(amps[(i + 1) % amps.length] * 0.5) }, t + i * 0.033);
            }
            set(el, { x: 0, y: 0 }, t + amps.length * 0.033);
          }
          // chromatic-split: stepped RGB fringe offsets (px), then rest
          function chroma(el, t, seq, rest) {
            for (var i = 0; i < seq.length; i++) {
              set(el, { "--rgb": seq[i] + "px" }, t + i * 0.045);
            }
            set(el, { "--rgb": (rest || 6) + "px" }, t + seq.length * 0.045);
          }

          // ---- group swaps (0ms) ----
          set(g1, { autoAlpha: 0 }, A.cut12);
          set(g2, { autoAlpha: 1 }, A.cut12);
          set(g2, { autoAlpha: 0 }, A.cut23);
          set(g3, { autoAlpha: 1 }, A.cut23);

          // ---- g1 ----
          // 13.421 한글날엔 slams full width
          set(hangul, { autoAlpha: 1 }, A.hangul);
          ft(hangul, { scale: 1.08 }, { scale: 1, duration: 0.34, ease: "expo.out" }, A.hangul);
          chroma(hangul, A.hangul, [22, 12, 18, 9]);
          shake(cam1, A.hangul, [1.1, -0.9, 0.7, -0.55, 0.4, -0.25, 0.14, -0.06]);

          // 15.116 syncopated accent: fringe tear + pop + short shake
          chroma(hangul, A.accent, [20, 8, 15, 7]);
          ft(hangul, { scale: 1 }, { scale: 1.035, duration: 0.05, ease: "power2.out" }, A.accent);
          ft(hangul, { scale: 1.035 }, { scale: 1, duration: 0.3, ease: "power3.out" }, A.accent + 0.05);
          shake(cam1, A.accent, [0.7, -0.55, 0.4, -0.25, 0.1]);

          // 15.557 역시 — HL pair rises BEHIND the type into the 역|시 gap (vertical path, never across 시)
          set(hangul, { autoAlpha: 0 }, A.yeoksi);
          set([yeoksi, hl1], { autoAlpha: 1 }, A.yeoksi);
          ft(yeoksi, { scale: 1.06 }, { scale: 1, duration: 0.32, ease: "expo.out" }, A.yeoksi);
          chroma(yeoksi, A.yeoksi, [22, 11, 17, 8]);
          ft(hl1, { y: px(16) }, { y: 0, duration: 0.55, ease: "power3.out" }, A.yeoksi);
          ft(hl1, { y: 0 }, { y: px(-0.8), duration: 1.1, ease: "sine.inOut" }, A.yeoksi + 0.56);
          ft(yeoksi, { scale: 1 }, { scale: 1.016, duration: 1.3, ease: "sine.inOut" }, A.yeoksi + 0.36);
          chroma(yeoksi, A.tick, [14, 8]);

          // 17.252 사극
          set([yeoksi, hl1], { autoAlpha: 0 }, A.sageuk);
          shake(cam1, A.sageuk, [1.0, -0.8, 0.6, -0.45, 0.28, -0.12]);

          // 사극 → ㅡ primes (17.624) → SURGE 18.112: bar stretches L→R while the view pans.
          // Built identically on the g1 copy and the g2 copy so the 18.158 swap is seamless.
          function strokeSeq(S) {
            set(S.w, { autoAlpha: 1 }, A.sageuk);
            ft(S.w, { scale: 1.08 }, { scale: 1, duration: 0.3, ease: "expo.out" }, A.sageuk);
            chroma(S.w, A.sageuk, [22, 11, 17, 8]);
            set(S.bar, { scaleX: 0.1 }, A.riser);
            ft(S.bar, { scaleX: 0.1 }, { scaleX: 0.2, duration: A.surge - A.riser, ease: "sine.in" }, A.riser);
            chroma(S.w, A.riser, [12, 8]);
            ft(S.bar, { scaleX: 0.2 }, { scaleX: 1, duration: 0.6, ease: "power2.out" }, A.surge);
            ft(S.sg, { x: 0 }, { x: px(-39), duration: 0.95, ease: "power2.inOut" }, A.surge);
            ft(S.sa, { x: 0 }, { x: px(-14), duration: 0.95, ease: "power2.in" }, A.surge);
            chroma(S.w, A.surge, [24, 12, 18, 9]);
          }
          strokeSeq(S1);
          strokeSeq(S2);

          // ---- g2 ----
          // lineup enters from off-screen right with the pan (HL + M behind the bar, BL in front)
          ft(hl2, { x: px(66) }, { x: 0, duration: 0.82, ease: "power3.out" }, A.cut12);
          ft(bl2, { x: px(80) }, { x: 0, duration: 0.84, ease: "power3.out" }, A.cut12 + 0.064);
          ft(m2, { x: px(40) }, { x: 0, duration: 0.76, ease: "power3.out" }, A.cut12 + 0.144);

          // 19.064 short shake
          shake(cam2, A.shake, [1.0, -0.8, 0.6, -0.45, 0.3, -0.15, 0.06]);
          chroma(S2.w, A.shake, [22, 10, 16, 8]);
          ft(drift2, { x: 0 }, { x: px(-0.8), duration: A.settle - 6.036, ease: "sine.inOut" }, 6.036);
          chroma(S2.w, A.perc, [14, 8]);

          // 20.062 → 20.712 settle: bar thickens to the g3 bar (16.5 / 6.4cqw), 극 exits left,
          // figures take their g3 lineup geometry (drift −0.8cqw compensated) → the 20.712 swap is invisible
          var E = { duration: A.cut23 - A.settle, ease: "power3.inOut" };
          ft(S2.sg, { x: px(-39), y: 0, scale: 1 }, Object.assign({ x: px(-112), y: px(-8.0333), scale: 4 / 3 }, E), A.settle);
          ft(hl2, { x: 0, y: 0, scale: 1 }, Object.assign({ x: px(-29.2), y: px(0.3), scale: 20.5 / 31 }, E), A.settle);
          ft(bl2, { x: 0, y: 0, scale: 1 }, Object.assign({ x: px(-8.2), y: px(-8.2), scale: 20.5 / 46 }, E), A.settle);
          ft(m2, { x: 0, y: 0, scale: 1 }, Object.assign({ x: px(-7.2), y: px(0.3), scale: 20 / 27 }, E), A.settle);

          // ---- g3 ----
          // 20.712 HL-pair-2 joins the lineup; 스물여덟 자에 새긴 sets into the bar
          ft(hlTwo, { scale: 1.07 }, { scale: 1, duration: 0.32, ease: "power3.out" }, A.cut23);
          copyChars.forEach(function (c, i) {
            ft(c, { y: px(4.6) }, { y: 0, duration: 0.3, ease: "power3.out" }, A.cut23 + i * 0.022);
          });
          // slow drift of the lineup (copy stays still)
          ft(line3, { x: 0 }, { x: px(-2.4), duration: A.end - A.cut23, ease: "sine.inOut" }, A.cut23);

          // 23.266 연모와 칼끝 lands lower left, syllable by syllable; LOW stretch holds it
          yeonSy.forEach(function (s, i) {
            var t = A.yeonmo + i * 0.05;
            set(s, { autoAlpha: 1 }, t);
            ft(s, { y: px(-4.3), scale: 1.1 }, { y: 0, scale: 1, duration: 0.32, ease: "expo.out" }, t);
          });
          chroma(yeonmo, A.yeonmo, [20, 10, 15, 8]);

          // 25.170 primes the cut: push-in accelerating into 25.821 + fringe tension
          ft(cam3, { scale: 1 }, { scale: 1.035, duration: A.end - A.prime, ease: "power2.in" }, A.prime);
          chroma(yeonmo, A.prime, [20, 9, 15], 10);
          set(yeonmo, { "--rgb": "18px" }, A.end - 0.1);

          // ---- grain: seeded 12 fps jitter across the whole frame ----
          function mulberry32(a) {
            return function () {
              a |= 0;
              a = (a + 0x6d2b79f5) | 0;
              var t = Math.imul(a ^ (a >>> 15), 1 | a);
              t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
              return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
          }
          var rnd = mulberry32(0x2f02);
          gsap.set(grain, { x: px((rnd() - 0.5) * 10), y: px((rnd() - 0.5) * 6) });
          for (var k = 1; k / 12 < A.end; k++) {
            set(grain, { x: px((rnd() - 0.5) * 10), y: px((rnd() - 0.5) * 6) }, Math.round((k / 12) * 1000) / 1000);
          }

          window.__timelines = window.__timelines || {};
          // fast cut: the 40 s timeline plays 2.2222x inside an outer timeline (user: 40s를 18초로 빠르게)
          var fast = gsap.timeline({ paused: true });
          fast.add(tl.paused(false).timeScale(2.222222), 0);
          window.__timelines[ID] = fast;
          fast.seek(0);
        })();
      </script>
    </template>
  </body>
