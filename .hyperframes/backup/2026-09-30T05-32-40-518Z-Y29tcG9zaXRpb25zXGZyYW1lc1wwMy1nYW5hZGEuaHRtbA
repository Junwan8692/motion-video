      <script>
        (function () {
          "use strict";

          var root =
            document.querySelector('#stage[data-composition-id="03-ganada"]') ||
            document.querySelector('[data-composition-id="03-ganada"]') ||
            document;
          function byId(id) {
            return root.querySelector("#" + id) || document.getElementById(id);
          }

          // Frame-local anchors: local = track − 25.821 (audiomap.json)
          var T = {
            g1: 0.0, //    25.821 downbeat — 가 slams (braam-punch)
            wipe: 0.05, // ink brush wipe starts, lands on the 26.448 beat
            hl: 0.627, //  26.448 beat — HL pair rises in on the right
            c1: 1.207, //  27.028 strong kick — "가볍게," (content-swap)
            coin: 1.741, // 27.562 snare — coin returns + "단 1코인"
            tick1: 2.159, // 27.980 hihat accent — fringe tick on 가
            g2: 2.507, //  28.328 strong snare — palette flip to ember (g1→g2 cut)
            bl: 3.181, //  29.002 beat — BL pair breaks out over the panels
            c2: 3.831, //  29.652 beat — copy
            pre3: 5.085, // 30.906 downbeat — glitch tick on 나 into the cut
            g3: 5.178, //  30.999 surge accent — inversion to ink (g2→g3 cut, system-replace)
            c3: 5.688, //  31.509 snare — ember splash + copy
            fl: 6.385, //  32.206 beat — sun brush flick + fringe tick
            end: 7.662 //  33.483 frame end (the 33.530 riser belongs to the next frame)
          };

          var tl = gsap.timeline({ paused: true });

          function mulberry32(a) {
            return function () {
              a |= 0;
              a = (a + 0x6d2b79f5) | 0;
              var t = Math.imul(a ^ (a >>> 15), 1 | a);
              t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
              return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
          }
          function showAt(el, t) {
            tl.set(el, { autoAlpha: 1 }, t);
          }
          function hideAt(el, t) {
            tl.set(el, { autoAlpha: 0 }, t);
          }
          // braam-punch: the syllable lands oversized and slams to rest with an elastic thud
          function slam(el, t, peak, dur) {
            tl.fromTo(el, { scale: peak }, { scale: 1, duration: dur, ease: "elastic.out(1, 0.55)" }, t);
          }
          // chromatic split: 0ms fringe jumps, then ease back to the 6px rest fringe (continuous chain)
          function fringe(el, t0, steps) {
            for (var i = 0; i < steps.length; i++) {
              tl.set(el, { "--f03-rx": steps[i][1] + "px" }, t0 + steps[i][0]);
            }
            var last = steps[steps.length - 1];
            tl.fromTo(
              el,
              { "--f03-rx": last[1] + "px" },
              { "--f03-rx": "6px", duration: 0.3, ease: "power2.out", immediateRender: false },
              t0 + last[0] + 0.066
            );
          }
          // content-swap: 0ms appearance plus a short left→right settle
          function pop(el, t) {
            hideAt(el, 0);
            showAt(el, t);
            tl.fromTo(el, { x: -28 }, { x: 0, duration: 0.2, ease: "power3.out" }, t);
          }

          // ---- group swaps (0ms cuts) ----
          var g1 = byId("f03-g1");
          var g2 = byId("f03-g2");
          var g3 = byId("f03-g3");
          showAt(g1, 0);
          hideAt(g2, 0);
          hideAt(g3, 0);
          hideAt(g1, T.g2);
          showAt(g2, T.g2);
          hideAt(g2, T.g3);
          showAt(g3, T.g3);

          // ---- g1 · 가 — accumulate: 가 → brush → HL pair → copy → coin ----
          var gly1 = byId("f03-g1-glyph");
          slam(byId("f03-g1-syl"), T.g1, 1.18, 0.62);
          fringe(gly1, T.g1, [[0, 26], [0.066, 10], [0.133, 20]]);
          fringe(gly1, T.tick1, [[0, 18], [0.066, 9]]);

          var brush = byId("f03-g1-brush");
          tl.set(brush, { rotation: -13 }, 0);
          tl.fromTo(
            brush,
            { clipPath: "inset(0% 100% 0% 0%)" },
            { clipPath: "inset(0% 0% 0% 0%)", duration: T.hl - T.wipe, ease: "power2.out" },
            T.wipe
          );

          tl.fromTo(byId("f03-g1-ghostwrap"), { x: -18 }, { x: 18, duration: T.g2, ease: "none" }, 0);

          var hl = byId("f03-g1-hlwrap");
          hideAt(hl, 0);
          showAt(hl, T.hl);
          tl.fromTo(hl, { x: -60, y: 300 }, { x: 0, y: 0, duration: 0.45, ease: "power3.out" }, T.hl);

          pop(byId("f03-g1-c1"), T.c1);
          pop(byId("f03-g1-c2"), T.coin);

          var coin = byId("f03-g1-coinwrap");
          hideAt(coin, 0);
          showAt(coin, T.coin);
          tl.fromTo(
            coin,
            { y: -110, rotation: -220, scale: 1.3 },
            { y: 0, rotation: 0, scale: 1, duration: 0.42, ease: "back.out(1.8)" },
            T.coin
          );

          // ---- g2 · 나 — palette flip + 3D panel flip, BL pair breaks out, copy ----
          var gly2 = byId("f03-g2-glyph");
          tl.set(gly2, { "--f03-rx": "6px" }, 0);
          slam(byId("f03-g2-syl"), T.g2, 1.2, 0.62);
          fringe(gly2, T.g2, [[0, 26], [0.066, 10], [0.133, 20]]);
          tl.set(gly2, { "--f03-rx": "20px" }, T.pre3);

          var p1 = byId("f03-g2-p1");
          var p2 = byId("f03-g2-p2");
          tl.set([p1, p2], { transformOrigin: "0% 50%", transformPerspective: 1400 }, 0);
          tl.fromTo(p1, { rotationY: -75 }, { rotationY: 0, duration: 0.5, ease: "power3.out" }, T.g2);
          tl.fromTo(p2, { rotationY: -75 }, { rotationY: 0, duration: 0.5, ease: "power3.out" }, T.g2 + 0.09);

          var bl = byId("f03-g2-blwrap");
          hideAt(bl, 0);
          showAt(bl, T.bl);
          tl.fromTo(bl, { y: 240 }, { y: 0, duration: 0.45, ease: "back.out(1.3)" }, T.bl);

          pop(byId("f03-g2-cw"), T.c2);

          // ---- g3 · 다 — system-replace to ink, chromatic split, M-group, splashes ----
          var gly3 = byId("f03-g3-glyph");
          tl.set(gly3, { "--f03-rx": "6px" }, 0);
          slam(byId("f03-g3-syl"), T.g3, 1.2, 0.7);
          fringe(gly3, T.g3, [[0, 30], [0.066, 10], [0.133, 24]]);
          fringe(gly3, T.fl, [[0, 16], [0.066, 8]]);

          var mg = byId("f03-g3-mwrap");
          hideAt(mg, 0);
          showAt(mg, T.g3);
          tl.fromTo(mg, { y: 280 }, { y: 0, duration: 0.45, ease: "power3.out" }, T.g3);

          var splash = byId("f03-g3-splashwrap");
          hideAt(splash, 0);
          showAt(splash, T.c3);
          tl.fromTo(
            splash,
            { scale: 0.82, rotation: -11 },
            { scale: 1, rotation: -6, duration: 0.24, ease: "expo.out" },
            T.c3
          );

          pop(byId("f03-g3-cw"), T.c3);

          var flick = byId("f03-g3-flick");
          tl.set(flick, { rotation: 10 }, 0);
          tl.fromTo(
            flick,
            { clipPath: "inset(0% 100% 0% 0%)" },
            { clipPath: "inset(0% 0% 0% 0%)", duration: 0.32, ease: "expo.out" },
            T.fl
          );

          // ---- grain: seeded offsets stepped at 12 fps (seek-safe, no CSS animation) ----
          var grain = byId("f03-grain-tex");
          var rnd = mulberry32(0x0325);
          var step = 1 / 12;
          var n = Math.floor(T.end / step);
          for (var i = 0; i <= n; i++) {
            tl.set(
              grain,
              { x: Math.round((rnd() - 0.5) * 192), y: Math.round((rnd() - 0.5) * 192) },
              Math.round(i * step * 1000) / 1000
            );
          }

          window.__timelines = window.__timelines || {};
          // fast cut: the 40 s timeline plays 2.2222x inside an outer timeline (user: 40s를 18초로 빠르게)
          var fast = gsap.timeline({ paused: true });
          fast.add(tl.paused(false).timeScale(2.222222), 0);
          window.__timelines["03-ganada"] = fast;
          fast.seek(0);
        })();
      </script>
